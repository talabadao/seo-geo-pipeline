{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/content_lint.py --hook",
            "description": "Lint content/ files after Claude writes them"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/secret_scan.py --hook",
            "description": "Block commits that contain secrets"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git status:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git push:*)", "Bash(git log:*)", "Bash(git diff:*)",
      "Bash(python3 scripts/*)"
    ],
    "deny": [
      "Read(./.credentials/credentials.yaml)",
      "Read(./.credentials/*.json)"
    ]
  }
}
